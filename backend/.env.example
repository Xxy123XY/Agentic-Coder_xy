# Groq — free key at console.groq.com
GROQ_API_KEY=
GROQ_REASON_MODEL=openai/gpt-oss-120b
GROQ_CODE_MODEL=openai/gpt-oss-120b

# GitHub — generate at github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/orchestrator.db

# Docker sandbox
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT=120

# App
DEBUG=true